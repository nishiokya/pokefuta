@@ -0,0 +1,128 @@
+"""公開用属性。蓋単位で隔離した検証データで適合率50%以上の属性だけを配信する。
+
+閾値は学習側だけのOOFで選ぶ。検証側は学習・閾値選択に使わず、評価後も再学習しない。
+学習: .venv/bin/python scripts/public_attrs.py --train
+"""
+import json
+import pickle
+from pathlib import Path
+import numpy as np
+from sklearn.model_selection import StratifiedGroupKFold
+import attr_models as A
+import train_scene_attrs as T
+
+ATTRS = ('person', 'snow', 'autumn', 'feet')
+VERSION = 'public_attrs/2'
+MODEL = T.ROOT / 'models' / 'public_attrs_v2.pkl'
+EVALUATION = 'group_holdout_v1'
+
+
+def validate_report(report):
+    """保存時と読み込み時の公開条件を1か所で検査する。NaN/欠損/文字列も拒否。"""
+    if report.get('status') != 'trained' or report.get('evaluation') != EVALUATION:
+        raise ValueError('公開属性の評価方式または学習状態が違う')
+    for name, lo, hi in (('precision', .5, 1.), ('threshold', 0., 1.)):
+        v = report.get(name)
+        if isinstance(v, bool) or not isinstance(v, (int, float)) or not np.isfinite(v) or not lo <= v <= hi:
+            raise ValueError(f'公開属性の {name} が不正: {v}')
+    if report.get('validation_positives', 0) < 1 or report.get('validation_predicted', 0) < 1:
+        raise ValueError('検証側の正例または予測陽性が無い')
+
+
+def fit_holdout(features, lab, attr):
+    ids = sorted(pid for pid, labels in lab.items() if attr in labels and pid in features.emb and pid in features.src)
+    y = np.array([lab[i][attr] for i in ids], dtype=int)
+    if y.sum() < A.MIN_POS or T.group_support(y, features.groups(ids)) < 5:
+        return None, dict(status='too_few', positives=int(y.sum()))
+    X, groups = features.X(ids), np.array(features.groups(ids))
+    # 分割を探し直して良い成績を選ばない。固定seed・最初のfoldを検証専用にする。
+    train_idx, valid_idx = next(StratifiedGroupKFold(n_splits=5, shuffle=True, random_state=17).split(X, y, groups))
+    if set(groups[train_idx]) & set(groups[valid_idx]):
+        raise ValueError('学習と検証に同じ蓋が混ざっている')
+    # A.report は閾値選択用にだけ使い、公開のprecisionには使わない。
+    tuned = A.report(y[train_idx], A.oof(X[train_idx], y[train_idx], groups[train_idx]))
+    threshold = tuned['threshold']
+    model = A.make().fit(X[train_idx], y[train_idx])
+    pred = model.predict_proba(X[valid_idx])[:, 1] >= threshold
+    truth = y[valid_idx]
+    tp = int((pred & (truth == 1)).sum())
+    report = dict(status='trained', evaluation=EVALUATION, threshold=threshold,
+                  positives=int(y.sum()), train_count=len(train_idx), validation_count=len(valid_idx),
+                  validation_positives=int(truth.sum()), validation_predicted=int(pred.sum()),
+                  validation_true_positive=tp,
+                  precision=tp / int(pred.sum()) if pred.sum() else 0.,
+                  recall=tp / int(truth.sum()) if truth.sum() else 0.)
+    # この同じモデルを保存する。検証側を含めた全件でのfitはしない。
+    return model, report
+
+
+def train():
+    if MODEL.exists():
+        raise SystemExit(f'{MODEL} は公開用の固定モデル。別の版に保存すること')
+    features, lab = A.Features(A.ALL_FEATURES), A.labels()
+    models, reports, excluded = {}, {}, {}
+    for attr in ATTRS:
+        model, report = fit_holdout(features, lab, attr)
+        try:
+            validate_report(report)
+            if model is None:
+                raise ValueError('モデルが無い')
+        except ValueError as e:
+            excluded[attr] = report
+            print(f'[除外] {attr}: {e}', json.dumps(report, ensure_ascii=False), flush=True)
+            continue
+        models[attr], reports[attr] = model, report
+        print(attr, json.dumps(report, ensure_ascii=False), flush=True)
+    if not models:
+        raise ValueError('公開基準を満たす属性が無い。モデルを保存しない')
+    artifact = dict(format=2, version=VERSION, features=list(A.ALL_FEATURES),
+                    models=models, reports=reports, excluded=excluded, db_backup=features.db_backup)
+    metadata = json.dumps({k: v for k, v in artifact.items() if k != "models"},
+                          ensure_ascii=False, indent=2, allow_nan=False)
+    tmp = MODEL.with_suffix(".tmp")
+    tmp.write_bytes(pickle.dumps(artifact))
+    tmp.replace(MODEL)
+    MODEL.with_suffix(".json").write_text(metadata)
+
+
+
+
+class PublicAttrs:
+    def __init__(self, path=MODEL):
+        with Path(path).open('rb') as f:
+            self.m = pickle.load(f)
+        models = self.m.get('models', {})
+        if (self.m.get('format') != 2 or self.m.get('version') != VERSION
+                or self.m.get('features') != list(A.ALL_FEATURES)
+                or not models or not set(models) <= set(ATTRS)
+                or set(models) != set(self.m.get('reports', {}))):
+            raise ValueError('公開属性モデルの形式が違う')
+        for report in self.m['reports'].values():
+            validate_report(report)
+
+    def tags(self, recs, embeddings, feats, det, ts):
+        ids = [r['photo_id'] for r in recs]
+        if len(set(ids)) != len(ids) or set(ids) != set(embeddings):
+            raise ValueError('公開属性の写真IDと埋め込みの対応が違う')
+        if not recs:
+            return {}
+        boxes = A.box_features({r['photo_id']: r for r in recs})
+        X = np.array([np.concatenate([
+            embeddings[r['photo_id']], T.hand_vector(feats.get(r['photo_id'])), T.det_features(det, r['photo_id']),
+            T.ts_features(ts, r['photo_id']), boxes.get(r['photo_id'], [0.] * 5)
+        ]) for r in recs])
+        probabilities = {a: model.predict_proba(X)[:, 1] for a, model in self.m['models'].items()}
+        if any(not np.isfinite(p).all() for p in probabilities.values()):
+            raise ValueError('公開属性の確率が有限でない')
+        return {pid: {
+            'attrs_model': self.m['version'],
+            **{a: bool(probabilities[a][i] >= self.m['reports'][a]['threshold']) for a in probabilities}
+        } for i, pid in enumerate(ids)}
+
+
+if __name__ == '__main__':
+    import argparse
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument('--train', action='store_true', required=True)
+    ap.parse_args()
+    train()
