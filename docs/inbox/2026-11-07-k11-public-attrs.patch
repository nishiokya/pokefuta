+++ b/scripts/tag_payload.py
@@ -0,0 +1,47 @@
+"""タグのJSON契約。標準ライブラリだけで使える（学習モデルをimportしない）。"""
+import json
+from numbers import Integral, Real
+
+
+def _plain(value):
+    if value is None or isinstance(value, (str, bool)):
+        return value
+    if isinstance(value, dict):
+        return {key: _plain(v) for key, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_plain(v) for v in value]
+    # numpyをimportせず、numpy scalarのitemだけを明示的に扱う。
+    if type(value).__module__.split('.')[0] == 'numpy' and hasattr(value, 'item'):
+        scalar = value.item()
+        if type(scalar).__module__.split('.')[0] == 'numpy':
+            raise TypeError('Python標準型に変換できないnumpy値')
+        return _plain(scalar)
+    if isinstance(value, Integral):
+        return int(value)
+    if isinstance(value, Real):
+        return float(value)
+    raise TypeError(f'JSONタグの値の型が不正: {type(value).__name__}')
+
+
+def normalize_tags(tags):
+    """標準型へ変換し、枠を4桁に丸め、空白込みUTF-8で500バイト以内にする。"""
+    out = _plain(tags)
+    for key in ('crop', 'lid', 'plush_box'):
+        if key in out:
+            out[key] = [round(float(v), 4) for v in out[key]]
+    for key, digits in (('plush_score', 3), ('rep_score', 4)):
+        if key in out:
+            out[key] = round(float(out[key]), digits)
+    size = len(json.dumps(out, ensure_ascii=False, allow_nan=False).encode('utf-8'))
+    if size > 500:
+        raise ValueError(f'公開タグが500バイト超（{size}バイト）')
+    return out
+
+
+def prepare_tags(tags, photo_id, errors):
+    """個別の不正値は記録してスキップする。採点済みにしないので修正後に再試行できる。"""
+    try:
+        return normalize_tags(tags)
+    except (ValueError, TypeError, OverflowError) as error:
+        errors.append({'photo_id': photo_id, 'reason': f'{type(error).__name__}: {error}'[:300]})
+        return None
