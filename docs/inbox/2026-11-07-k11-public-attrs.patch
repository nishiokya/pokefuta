diff --git a/scripts/test_public_attrs.py b/scripts/test_public_attrs.py
new file mode 100644
index 0000000..9a57be0
--- /dev/null
+++ b/scripts/test_public_attrs.py
@@ -0,0 +1,102 @@
+"""公開属性の評価分離・保存条件・ID照合・枠欠損・DBサイズ契約の回帰テスト。"""
+import json
+import unittest
+from unittest.mock import patch
+import numpy as np
+import public_attrs as P
+import attr_models as A
+
+
+def valid_report():
+    return dict(status='trained', evaluation=P.EVALUATION, precision=.5, threshold=.5,
+                validation_positives=1, validation_predicted=2)
+
+
+class CaptureModel:
+    def predict_proba(self, X):
+        self.X = X
+        p = np.clip(X[:, 0], 0, 1)
+        return np.column_stack([1 - p, p])
+
+
+class PublicAttrsTest(unittest.TestCase):
+    def test_same_validation_rejects_nonfinite_and_invalid_reports(self):
+        P.validate_report(valid_report())  # ちょうど50%は採用
+        for key, values in {
+            'precision': [float('nan'), float('inf'), .499, 1.1, None, '0.9', True],
+            'threshold': [float('nan'), float('inf'), -.1, 1.1, None],
+            'status': ['too_few', None], 'evaluation': ['oof', None],
+            'validation_positives': [0], 'validation_predicted': [0]
+        }.items():
+            for value in values:
+                with self.subTest(key=key, value=value), self.assertRaises(ValueError):
+                    P.validate_report({**valid_report(), key: value})
+
+    def test_missing_boxes_and_id_order_match_training(self):
+        features = A.Features.__new__(A.Features)
+        features.use = A.ALL_FEATURES
+        features.emb = {'a': np.array([.1, .2]), 'b': np.array([.8, .9])}
+        features.hand, features.det, features.ts, features.box = {}, {}, {}, {}
+        recs = [dict(photo_id=i, path='not-used') for i in ('b', 'a')]
+        model = CaptureModel()
+        pub = P.PublicAttrs.__new__(P.PublicAttrs)
+        pub.m = dict(version=P.VERSION, models={'snow': model}, reports={'snow': valid_report()})
+        with patch.object(A, 'box_features', return_value={}):
+            out = pub.tags(recs, features.emb, {}, {}, {})
+        np.testing.assert_array_equal(model.X, features.X(['b', 'a']))
+        self.assertTrue(out['b']['snow'])
+        self.assertFalse(out['a']['snow'])
+        self.assertTrue(np.all(model.X[:, -5:] == 0))
+        for bad_recs, bad_emb in ((recs, {'a': features.emb['a']}),
+                                  ([recs[0], recs[0]], features.emb)):
+            with self.assertRaises(ValueError):
+                pub.tags(bad_recs, bad_emb, {}, {}, {})
+
+    def test_holdout_is_never_used_for_fit_or_threshold(self):
+        # 30の蓋ごとに正例と負例。IDの並びと特徴量の先頭列を対応させる。
+        ids = [f'{i:03}' for i in range(60)]
+        class Features:
+            emb = dict.fromkeys(ids)
+            src = dict.fromkeys(ids)
+            def groups(self, subset):
+                return [int(i) // 2 for i in subset]
+            def X(self, subset):
+                return np.array([[int(i), int(i) % 2] for i in subset], dtype=float)
+        labels = {i: {'snow': bool(int(i) % 2)} for i in ids}
+        calls = {}
+        class Model:
+            def fit(self, X, y):
+                calls['fit'] = X[:, 0].copy()
+                return self
+            def predict_proba(self, X):
+                calls['validation'] = X[:, 0].copy()
+                return np.column_stack([1-X[:,1], X[:,1]])
+        def oof(X, y, groups):
+            calls['threshold'] = X[:, 0].copy()
+            return y * .8 + .1
+        with patch.object(A, 'make', return_value=Model()), patch.object(A, 'oof', side_effect=oof):
+            _, report = P.fit_holdout(Features(), labels, 'snow')
+        self.assertEqual(set(calls['fit']), set(calls['threshold']))
+        self.assertFalse(set(calls['fit']) & set(calls['validation']))
+        self.assertFalse({int(i)//2 for i in calls['fit']} & {int(i)//2 for i in calls['validation']})
+        self.assertEqual(report['precision'], 1.)
+        P.validate_report(report)
+
+    def test_tag_rounding_and_worst_case_size(self):
+        tags = dict(model='s'*40, attrs_model='a'*40, scene='centered_clean',
+                    plush=True, plush_score=.9999999999, night=False, lid_fits=False,
+                    rep_score=-999.999999999, person=False, snow=False, autumn=False, feet=False)
+        for k in ('crop', 'lid', 'plush_box'):
+            tags[k] = [.15640000000000001, .1234567890123, .9876543210987, .8765432109876]
+        out = P.normalize_tags(tags)
+        self.assertEqual(out['lid'], [.1564, .1235, .9877, .8765])
+        self.assertLessEqual(len(json.dumps(out).encode()), 500)
+        self.assertNotEqual(tags['lid'], out['lid'])
+        with self.assertRaises(ValueError):
+            P.normalize_tags({**tags, 'unexpected': 'x'*501})
+        with self.assertRaises(ValueError):
+            P.normalize_tags({'rep_score': float('nan')})
+
+
+if __name__ == '__main__':
+    unittest.main()
